# POTB Sales Report — Environment Variables (TEMPLATE)
# ============================================================================
# Copy this file to `.env` and fill in the REAL values locally.
# NEVER commit real secrets — `.env` and `.env.local` are gitignored.
# For the Vercel deployment, set these same keys under
#   Vercel → Project → Settings → Environment Variables
# (server-side keys stay server-side; only VITE_* reach the browser).
# ============================================================================

# --- YouCanBook.me · POTB account (server-side; injected by the API proxy) ---
YCBM_ACCOUNT_ID=your-ycbm-account-id
YCBM_API_KEY=your-ycbm-api-key

# --- YouCanBook.me · AACIO external team (2nd account) ----------------------
YCBM_AACIO_ACCOUNT_ID=your-aacio-account-id
YCBM_AACIO_API_KEY=your-aacio-api-key

# --- Supabase (publishable/anon key + URL are safe in the browser) ----------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Supabase SECRET key — server-side ONLY, never prefix with VITE_ ---------
# Used by scripts/ (migrations, seeding, create-user, set-role). Rotate after use.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Meta Ads API — server-side only (proxy appends the token) --------------
# For production use a long-lived System User token (Business Settings).
META_AD_ACCOUNT_ID=act_xxxxxxxxxxxxx
META_ACCESS_TOKEN=your-meta-access-token

# --- Fusioo (Booking Transactions for Account Officer attribution) ----------
FUSIOO_CLIENT_ID=your-fusioo-client-id
FUSIOO_CLIENT_SECRET=your-fusioo-client-secret
FUSIOO_APP_ID=your-fusioo-app-id
FUSIOO_WORKSPACE=your-fusioo-workspace
FUSIOO_ACCESS_TOKEN=your-fusioo-access-token
