{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/ycbm/:path*",   "destination": "/api/proxy" },
    { "source": "/api/aacio/:path*",  "destination": "/api/proxy" },
    { "source": "/api/lakbay/:path*", "destination": "/api/proxy" },
    { "source": "/api/fusioo/:path*", "destination": "/api/proxy" },
    { "source": "/api/meta/:path*",   "destination": "/api/proxy" },
    { "source": "/api/hl/:path*",     "destination": "/api/proxy" },
    { "source": "/tv",        "destination": "/index.html" },
    { "source": "/tv/:path*", "destination": "/index.html" }
  ]
}
